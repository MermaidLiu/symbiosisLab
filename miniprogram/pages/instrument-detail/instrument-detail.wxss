.page {
  padding-bottom: 40rpx;
}

.hero {
  background: linear-gradient(145deg, rgba(208, 238, 255, 0.95), rgba(237, 224, 255, 0.95));
}

.title {
  font-size: 36rpx;
  font-weight: 800;
  color: #5b3a9e;
}

.en {
  margin-top: 8rpx;
  color: #7a7190;
  font-size: 24rpx;
}

.chips {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
}

.chip {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: #c8f7e0;
  color: #1b7a5a;
  font-weight: 600;
}

.chip-alt {
  background: #fff6c2;
  color: #8a7a12;
}

.meta {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #4b4560;
}

.desc {
  margin-top: 18rpx;
  line-height: 1.55;
  color: #5a5470;
  font-size: 26rpx;
}

.section {
  font-weight: 700;
  margin-bottom: 18rpx;
  font-size: 30rpx;
}

.field {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.label {
  width: 100rpx;
  color: #7a7190;
  font-size: 26rpx;
}

.picker,
.input {
  flex: 1;
  background: #f7f2ff;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  border: 2rpx solid #ede0ff;
}

.hint {
  margin-top: 16rpx;
  font-size: 22rpx;
}
