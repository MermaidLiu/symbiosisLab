.wrap {
  padding: 24rpx;
  min-height: 100vh;
  background: linear-gradient(165deg, #ede0ff, #f5fbff);
}
.card {
  background: rgba(255, 255, 255, 0.92);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.title {
  font-size: 32rpx;
  font-weight: 700;
  color: #5b3a9e;
}
.sub,
.label {
  font-size: 24rpx;
  color: #7a7190;
  margin-top: 8rpx;
}
.status {
  margin-top: 16rpx;
  padding: 12rpx 16rpx;
  background: #fff7ed;
  color: #9a3412;
  border-radius: 12rpx;
  font-size: 26rpx;
}
.err {
  margin-top: 8rpx;
  color: #b91c1c;
  font-size: 24rpx;
}
.input {
  background: #f7f2ff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin: 8rpx 0 16rpx;
}
.picker {
  padding: 16rpx 0;
  color: #5b3a9e;
}
.btn {
  margin-top: 16rpx;
  background: #7b4db8;
  color: #fff;
  border-radius: 16rpx;
}
.link {
  background: transparent;
  color: #7a7190;
  font-size: 24rpx;
}
