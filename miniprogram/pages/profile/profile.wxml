<view class="wrap">
  <view class="card">
    <view class="title">个人信息</view>
    <view class="sub">可查看与修改；姓名、邮箱、学校、学号等必填项不可删除清空</view>
  </view>

  <view class="card">
    <view class="label">{{phoneLocked ? '手机号（登录凭证，不可改）' : '手机号'}}</view>
    <input class="input" type="number" maxlength="11" value="{{phone}}" disabled="{{phoneLocked}}" bindinput="onPhone" />
    <view class="label">姓名 *</view>
    <input class="input" value="{{name}}" bindinput="onName" />
    <view class="label">邮箱 *</view>
    <input class="input" value="{{email}}" bindinput="onEmail" placeholder="name@university.edu.cn" />
    <view class="label">学校 / 单位 *</view>
    <input class="input" value="{{school}}" bindinput="onSchool" />
    <view class="label">实验室 / 课题组 *</view>
    <input class="input" value="{{department}}" bindinput="onDept" />
    <view class="label">学号 / 学生证号 / 工号 *</view>
    <input class="input" value="{{employeeId}}" bindinput="onEmp" />
    <view class="label">人员类型 *</view>
    <input class="input" value="{{personType}}" bindinput="onPerson" />
    <view class="label">其他联系方式</view>
    <input class="input" value="{{contactExtra}}" bindinput="onContact" />
    <view class="label">花名</view>
    <input class="input" value="{{nickname}}" bindinput="onNick" />
    <view wx:if="{{msg}}" class="ok">{{msg}}</view>
    <button class="btn" loading="{{busy}}" bindtap="onSave">保存修改</button>
  </view>

  <view class="card">
    <view class="title">修改登录密码</view>
    <view class="sub">用于邮箱密码登录；需验证当前密码，新密码至少 6 位</view>
    <view class="label">当前密码 *</view>
    <input class="input" password value="{{currentPassword}}" bindinput="onCurrentPwd" />
    <view class="label">新密码 *</view>
    <input class="input" password value="{{newPassword}}" bindinput="onNewPwd" />
    <view class="label">确认新密码 *</view>
    <input class="input" password value="{{confirmPassword}}" bindinput="onConfirmPwd" />
    <view wx:if="{{pwdMsg}}" class="ok">{{pwdMsg}}</view>
    <button class="btn" loading="{{pwdBusy}}" bindtap="onChangePassword">修改密码</button>
  </view>

  <button class="link" bindtap="onLogout">退出登录</button>
</view>
