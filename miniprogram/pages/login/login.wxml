<view class="wrap">
  <view class="blob blob-a"></view>
  <view class="blob blob-b"></view>
  <view class="hero">
    <view class="brand">Symbiosis Lab</view>
    <view class="sub">实名制 · 手机号登录</view>
  </view>

  <view class="card form" wx:if="{{insecureApi}}">
    <view class="warn-title">体验版暂不可用</view>
    <view class="warn-body">请配置 HTTPS 域名后再试。</view>
    <view class="api muted">{{apiBase}}</view>
  </view>

  <view class="card form" wx:elif="{{mode === 'phone'}}">
    <view class="label">手机号</view>
    <input class="input" type="number" maxlength="11" placeholder="11 位手机号" value="{{phone}}" bindinput="onPhone" />
    <view class="label">短信验证码</view>
    <view class="row-code">
      <input class="input flex1" type="number" maxlength="6" placeholder="验证码" value="{{code}}" bindinput="onCode" />
      <button class="btn-sms" loading="{{sending}}" disabled="{{countdown > 0}}" bindtap="onSendSms">
        {{countdown > 0 ? countdown + 's' : '获取验证码'}}
      </button>
    </view>
    <view wx:if="{{smsHint}}" class="hint muted">{{smsHint}}</view>
    <button class="btn-primary login-btn" loading="{{loading}}" disabled="{{checking}}" bindtap="onPhoneLogin">
      {{checking ? "检查登录中…" : "登录"}}
    </button>
    <view class="hint muted" bindtap="toggleMode">演示账号：邮箱密码登录</view>
    <view class="api muted">{{apiBase}}</view>
  </view>

  <view class="card form" wx:else>
    <view class="label">邮箱</view>
    <input class="input" type="text" placeholder="student@lab.edu.cn" value="{{email}}" bindinput="onEmail" />
    <view class="label">密码</view>
    <input class="input" password placeholder="demo123" value="{{password}}" bindinput="onPassword" />
    <button class="btn-primary login-btn" loading="{{loading}}" disabled="{{checking}}" bindtap="onLogin">
      邮箱密码登录
    </button>
    <view class="hint muted" bindtap="toggleMode">返回手机号登录</view>
    <view class="api muted">{{apiBase}}</view>
  </view>
</view>
