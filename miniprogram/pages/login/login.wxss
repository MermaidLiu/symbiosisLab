.wrap {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  padding: 72rpx 32rpx 48rpx;
  background: linear-gradient(165deg, #ede0ff 0%, #d0eeff 40%, #fff6c2 100%);
}

.blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(2rpx);
  opacity: 0.55;
}

.blob-a {
  width: 280rpx;
  height: 280rpx;
  right: -60rpx;
  top: 40rpx;
  background: radial-gradient(circle, #ffd6e0, transparent 70%);
}

.blob-b {
  width: 240rpx;
  height: 240rpx;
  left: -50rpx;
  top: 280rpx;
  background: radial-gradient(circle, #c8f7e0, transparent 70%);
}

.hero {
  position: relative;
  color: #5b3a9e;
  padding: 24rpx 12rpx 48rpx;
}

.brand {
  font-size: 48rpx;
  font-weight: 800;
}

.sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #7a7190;
}

.form {
  position: relative;
  margin: 0;
  background: rgba(255, 255, 255, 0.88);
}

.label {
  font-size: 24rpx;
  color: #7a7190;
  margin-bottom: 8rpx;
  margin-top: 16rpx;
}

.input {
  background: #f7f2ff;
  border-radius: 18rpx;
  padding: 22rpx 24rpx;
  border: 2rpx solid #ede0ff;
}

.login-btn {
  margin-top: 40rpx;
}

.row-code {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.row-code .flex1 {
  flex: 1;
}

.btn-sms {
  flex-shrink: 0;
  font-size: 24rpx;
  padding: 0 20rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: #f7f2ff;
  color: #5b3a9e;
  border-radius: 18rpx;
}

.warn-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #9a3412;
  margin-bottom: 16rpx;
}

.warn-body {
  font-size: 26rpx;
  line-height: 1.55;
  color: #5c5470;
  margin-bottom: 16rpx;
}

.hint,
.api {
  margin-top: 18rpx;
  font-size: 22rpx;
  text-align: center;
}

.browse-back {
  color: var(--brand-deep);
  text-decoration: underline;
}

.consent {
  display: flex;
  gap: 14rpx;
  align-items: flex-start;
  margin-top: 28rpx;
}

.check {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  border: 2rpx solid #b9a6d8;
  background: #fff;
  flex-shrink: 0;
  margin-top: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #fff;
  line-height: 1;
}

.check.on {
  background: #7b4db8;
  border-color: #7b4db8;
}

.consent-text {
  flex: 1;
  font-size: 22rpx;
  line-height: 1.55;
  color: #6b6280;
}

.consent-text .link {
  color: #5b3a9e;
  text-decoration: underline;
  font-weight: 600;
}

.api {
  font-size: 20rpx;
  word-break: break-all;
  opacity: 0.7;
}
