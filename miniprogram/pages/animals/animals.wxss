.page {
  padding-bottom: 40rpx;
}

.swipe-wrap {
  position: relative;
  margin: 0 24rpx 20rpx;
  overflow: hidden;
  border-radius: 24rpx;
}

.swipe-wrap .animal {
  margin: 0;
  position: relative;
  z-index: 2;
  transition: transform 0.15s ease-out;
}

.swipe-actions {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 152rpx;
  display: flex;
  align-items: stretch;
  z-index: 1;
}

.swipe-del {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e11d48;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
}

.assign-btn {
  margin-top: 16rpx;
  background: #7b4db8 !important;
  color: #fff !important;
}

.assign-sheet .hint {
  margin: 12rpx 0 8rpx;
  font-size: 22rpx;
  line-height: 1.45;
}

.search {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 18rpx 24rpx;
}

.search-icon {
  font-size: 28rpx;
}

.search .ali-icon {
  flex-shrink: 0;
}

.search-input {
  flex: 1;
}

.lifecycle-entry {
  flex-direction: column;
  align-items: flex-start;
  background: linear-gradient(135deg, rgba(123, 77, 184, 0.12), rgba(255, 246, 194, 0.35));
}

.entry-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #5b3a9e;
}

.entry-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
}

.animal .row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.id {
  font-family: monospace;
  font-weight: 800;
  color: #5b3a9e;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.lock {
  font-size: 26rpx;
}

.backfill {
  padding: 2rpx 10rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #9a3412;
  background: #ffedd5;
  border-radius: 8rpx;
}

.dead-badge {
  padding: 2rpx 10rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #9f1239;
  background: #ffe4e6;
  border-radius: 8rpx;
}

.animal.locked {
  border: 2rpx solid rgba(245, 158, 11, 0.45);
  background: rgba(255, 247, 237, 0.9);
}

.line {
  margin-top: 6rpx;
  font-size: 24rpx;
}

.edit-hint {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #9a90b0;
}

.mask {
  position: fixed;
  inset: 0;
  background: rgba(50, 30, 80, 0.35);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}

.editor {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 36rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -12rpx 40rpx rgba(123, 77, 184, 0.15);
}

.editor-title {
  font-weight: 800;
  font-size: 32rpx;
  margin-bottom: 20rpx;
  color: #5b3a9e;
}

.input {
  background: #f7f2ff;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  border: 2rpx solid #ede0ff;
}

.color-label {
  margin: 22rpx 0 14rpx;
  font-size: 24rpx;
}

.colors {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.swatch {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  border: 4rpx solid transparent;
  box-shadow: 0 6rpx 14rpx rgba(90, 70, 120, 0.12);
}

.swatch.on {
  border-color: #7b4db8;
  transform: scale(1.12);
}

.editor-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 28rpx;
}
