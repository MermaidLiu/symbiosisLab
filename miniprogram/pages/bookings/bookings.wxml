<view class="page">
  <view class="card guest-card" wx:if="{{guestMode}}">
    <view class="guest-title">我的预约</view>
    <view class="guest-desc muted">查看与管理仪器预约。登录后可提交预约并跟踪审批状态。</view>
    <button class="btn-primary" bindtap="goLogin">登录后查看</button>
  </view>

  <block wx:else>
  <view wx:if="{{list.length === 0}}" class="empty">暂无预约</view>

  <view class="card item" wx:for="{{list}}" wx:key="id">
    <view class="row">
      <view class="name">{{item.resourceName}}</view>
      <view class="badge badge-{{item.status}}">{{item.statusText}}</view>
    </view>
    <view class="muted line">{{item.timeRange}}</view>
    <view class="muted line">用途：{{item.purpose}}</view>
    <view class="ops" wx:if="{{item.status === 'pending' || item.status === 'approved'}}">
      <button
        size="mini"
        class="btn-ghost"
        data-id="{{item.id}}"
        bindtap="onCancel"
      >取消预约</button>
    </view>
  </view>
  </block>
</view>
