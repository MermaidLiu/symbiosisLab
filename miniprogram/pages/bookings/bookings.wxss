.page {
  padding-bottom: 32rpx;
}

.item .row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.name {
  flex: 1;
  font-weight: 700;
  font-size: 30rpx;
}

.line {
  margin-top: 6rpx;
  font-size: 24rpx;
}

.badge {
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-weight: 600;
}

.badge-approved {
  background: #c8f7e0;
  color: #1b7a5a;
}

.badge-pending {
  background: #fff6c2;
  color: #8a7a12;
}

.badge-cancelled,
.badge-rejected {
  background: #ede0ff;
  color: #5b3a9e;
}

.badge-completed {
  background: #d0eeff;
  color: #1a6b8a;
}

.ops {
  margin-top: 18rpx;
}
