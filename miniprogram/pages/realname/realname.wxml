<view class="wrap">
  <view class="card">
    <view class="title">完善个人资料</view>
    <view class="sub">首次登录须填写姓名、邮箱、学号、学校等；之后可在个人信息中修改，不可删除清空</view>
    <view class="status">{{statusText}}</view>
    <view wx:if="{{rejectReason}}" class="err">原因：{{rejectReason}}</view>
  </view>

  <view class="card" wx:if="{{canSubmit}}">
    <view class="label">姓名 *</view>
    <input class="input" value="{{name}}" bindinput="onName" />
    <view class="label">手机号</view>
    <input class="input" value="{{phone}}" disabled />
    <view class="label">邮箱 *</view>
    <input class="input" value="{{email}}" bindinput="onEmail" placeholder="name@university.edu.cn" />
    <view class="label">学校 / 单位 *</view>
    <input class="input" value="{{school}}" bindinput="onSchool" placeholder="例如 清华大学" />
    <view class="label">实验室/课题组 *</view>
    <input class="input" value="{{department}}" bindinput="onDept" />
    <view class="label">学号 / 学生证号 / 工号 *</view>
    <input class="input" value="{{employeeId}}" bindinput="onEmp" />
    <view class="label">人员类型 *</view>
    <input class="input" value="{{personType}}" bindinput="onPerson" />
    <view class="label">其他联系方式</view>
    <input class="input" value="{{contactExtra}}" bindinput="onContact" />
    <view class="label" wx:if="{{!alreadyActive}}">申请角色 *</view>
    <picker wx:if="{{!alreadyActive}}" mode="selector" range="{{roles}}" range-key="l" value="{{appliedIndex}}" bindchange="onRole">
      <view class="picker">{{roles[appliedIndex].l}}</view>
    </picker>
    <button class="btn" loading="{{busy}}" bindtap="onSubmit">{{alreadyActive ? '保存并继续' : '提交审核'}}</button>
  </view>

  <button class="link" bindtap="onLogout">退出登录</button>
</view>
