.page{padding:24rpx}.card{background:white;border-radius:16rpx;padding:24rpx;margin-bottom:24rpx}.board{width:1600rpx}.row{display:flex}.cell{width:200rpx;min-height:110rpx;border:1rpx solid #d8c9e4;padding:8rpx;box-sizing:border-box}.error{color:#b91c1c}input,textarea{border:1rpx solid #d8c9e4;padding:14rpx;margin:12rpx 0}button{margin-top:12rpx}.photo{width:150rpx;height:150rpx;margin:8rpx}

.modes,.rack-tabs{display:flex;gap:12rpx}.rack-tabs{margin-bottom:20rpx}.rack-tabs button{font-size:23rpx;padding:0 18rpx}.rack-tabs .active{background:#75258c;color:white}.board{width:1640rpx}.row-number{width:48rpx;flex-shrink:0;text-align:center;align-self:center;font-weight:600}.cell{width:192rpx;flex-shrink:0;border-radius:6rpx;margin:3rpx;background:#f6f5f8;font-size:24rpx}.cell.heading{min-height:45rpx;text-align:center;border:0;font-weight:600;background:white}.cell.blank{background:#e4f2cf;border-color:#c6dfaa}.cell.signal{background:#fff0bf;border-color:#ebd38c}.cell.exiting{background:#fbe0df;border-color:#edb5b1}.cell.other{background:white}.cell.dimmed{opacity:.28}.owners{font-weight:600;margin:8rpx 0}.legend{font-size:22rpx;color:#71647a;margin:16rpx 0}.mask{position:fixed;inset:0;background:#0005;z-index:100;display:flex;align-items:center;justify-content:center;padding:24rpx}.sheet{width:100%;max-height:85vh;overflow-y:auto;box-sizing:border-box}.sheet .title{font-size:34rpx;font-weight:600;margin-bottom:20rpx}.mouse-row{padding:18rpx 0;border-bottom:1rpx solid #eee;display:flex;align-items:center}.sheet picker{padding:18rpx 0}

.enroll-mask{z-index:110}
