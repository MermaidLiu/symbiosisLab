dex:9;background:#f6f7fb;padding:12rpx 0;margin:0 0 12rpx;gap:12rpx}.rack-tabs button{flex:1;background:white;color:#97869f;font-size:25rpx;min-height:68rpx;margin:0;padding:16rpx 10rpx;border:1rpx solid #e4deeb;line-height:1.2}.rack-tabs .active{background:#efe5f7;color:#764394;border-color:#d8c1e9;font-weight:600}.rack-title{font-size:24rpx;color:#a497ae;margin:18rpx 2rpx 24rpx}.row-title{font-size:22rpx;color:#a99bb3;margin:26rpx 2rpx 14rpx}.vertical-cages{gap:16rpx}.cage-card{padding:20rpx;background:#fff;border:1rpx solid #e6e0ed;border-radius:16rpx;min-height:125rpx}.cage-heading{font-size:27rpx;align-items:center}.cage-heading .muted{font-size:21rpx;font-weight:400;background:#ffffffb3;padding:4rpx 10rpx;border-radius:8rpx;color:#97869f}.cage-empty{font-size:22rpx;color:#b7aabc;padding:30rpx 0 20rpx}.cage-mouse{padding:8rpx 0;font-size:23rpx;color:#695277}.cage-card.blank{background:#f0f6e8;border-color:#e1ead5}.cage-card.signal{background:#fff6df;border-color:#f0e5c8}.cage-card.exiting{background:#fcf0ef;border-color:#efd8d5}.dispatch-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:18rpx}.section-title{font-size:28rpx;font-weight:600}.selection-count{font-size:21rpx;color:#8b61a6;background:#f4eef9;border-radius:8rpx;padding:6rpx 14rpx}.picker-field{display:flex;align-items:center;gap:18rpx;padding:20rpx 0;border-bottom:1rpx solid #f1edf5;font-size:25rpx}.picker-field .field-label{color:#a395ad;min-width:120rpx}.picker-field .ali-icon{margin-left:auto;opacity:.55;width:24rpx;height:24rpx}.page input,.page textarea{font-size:25rpx;border:1rpx solid #e7e0ed;border-radius:12rpx;background:#fbfafc;padding:18rpx 20rpx;margin:18rpx 0;box-sizing:border-box;min-height:76rpx}.page .search-box input{min-height:auto;border:0;border-radius:0;background:transparent;padding:0;margin:0}.page button.primary-action{background:#7743a4;border-color:#7743a4;color:white;min-height:78rpx}.page button.primary-action[disabled]{background:#e7deee;b