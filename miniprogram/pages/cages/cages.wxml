<view class="page"><view class="error">{{error}}</view>
<view class="card modes"><button size="mini" bindtap="goList">列表模式</button><button size="mini">笼位模式</button><button size="mini" bindtap="showEnroll">录入小鼠</button></view><input placeholder="搜索小鼠 ID / 小鼠名" value="{{query}}" bindinput="search"/><view class="rack-tabs"><button wx:for="{{racks}}" wx:key="name" size="mini" data-index="{{index}}" bindtap="pickRack" class="{{rackIndex===index?'active':''}}">{{item.name}}</button></view><view class="legend">绿：空白鼠 · 黄：测信号 · 红：待退出 · 白：不测信号</view><view class="card" wx:for="{{racks}}" wx:for-item="rack" wx:key="name" hidden="{{index!==rackIndex}}"><view>{{rack.name}} · 连点两次笼位查看详情</view><scroll-view scroll-x><view class="board"><view class="row"><view class="row-number"></view><view class="cell heading" wx:for="{{rack.columns}}" wx:key="*this">{{item}}</view></view><view class="row" wx:for="{{rack.rows}}" wx:for-item="row" wx:key="row"><view class="row-number">{{row.row}}</view><view class="cell {{cell.tone}} {{cell.dimmed?'dimmed':''}}" wx:for="{{row.cells}}" wx:for-item="cell" wx:key="number" data-number="{{cell.number}}" bindtap="pick"><view>{{cell.number}}</view><view class="owners">{{cell.owners}}</view><view wx:for="{{cell.mice}}" wx:for-item="mouse" wx:key="id"><checkbox checked="{{mouse.checked}}" data-id="{{mouse.id}}" catchtap="choose"/><text data-id="{{mouse.id}}" catchtap="open">{{mouse.id}}</text></view></view></view></view></scroll-view></view>
<view class="card" wx:if="{{legacy.length}}"><view>其他及历史笼位</view><view wx:for="{{legacy}}" wx:key="id"><checkbox checked="{{item.checked}}" data-id="{{item.id}}" bindtap="choose"/><text data-id="{{item.id}}" bindtap="open">{{item.id}} · {{item.cageLocation}}</text></view></view>
<view class="card" id="dispatch"><view>批量派发 · 已选 {{selectedCount}} 只</view><picker range="{{types}}" range-key="l" value="{{typeIndex}}" data-field="typeIndex" bindchange="field"><view>任务：{{types[typeIndex].l}}</view></picker><picker range="{{staff}}" range-key="name" value="{{staffIndex}}" data-field="staffIndex" bindchange="field"><view>主负责人：{{staff[staffIndex].name || '请选择'}}</view></picker><input placeholder="协助人（可选）" value="{{assistantNames}}" data-field="assistantNames" bindinput="field"/><button loading="{{busy}}" disabled="{{busy || !selectedCount}}" bindtap="dispatch">批量派发给主负责人</button></view>
<view class="mask enroll-mask" wx:if="{{enrollOpen}}" bindtap="closeEnroll"><view class="card sheet" catchtap="noop"><view>录入小鼠 · {{cageNumber}}</view><button bindtap="scan">扫描小鼠二维码</button><input placeholder="二维码内容" value="{{qrCode}}" data-field="qrCode" bindinput="field"/><input placeholder="小鼠名，例如 TJ001" value="{{id}}" data-field="id" bindinput="field"/><picker mode="date" value="{{entryDate}}" data-field="entryDate" bindchange="field"><view>进入日期：{{entryDate}}</view></picker><picker range="{{owners}}" range-key="name" value="{{ownerIndex}}" disabled="{{!manager}}" data-field="ownerIndex" bindchange="field"><view>所属人：{{owners[ownerIndex].name}}</view></picker><picker range="{{strainOptions}}" bindchange="pickStrain"><view>选择品系：转基因 / C57</view></picker><input placeholder="品系（可自行输入）" value="{{strain}}" data-field="strain" bindinput="field"/><picker range="{{entryTypes}}" value="{{entryIndex}}" data-field="entryIndex" bindchange="field"><view>进入类型：{{entryTypes[entryIndex]}}</view></picker><input wx:if="{{entryIndex==4}}" placeholder="请填写其他类型" value="{{entryTypeOther}}" data-field="entryTypeOther" bindinput="field"/><picker range="{{housingTypes}}" range-key="label" value="{{housingIndex}}" data-field="housingIndex" bindchange="field"><view>同笼饲养情况：{{housingTypes[housingIndex].label}}</view></picker><input type="digit" placeholder="周龄（如6或8）" value="{{ageWeeks}}" data-field="ageWeeks" bindinput="field"/><input placeholder="备注" value="{{entryNote}}" data-field="entryNote" bindinput="field"/><button loading="{{busy}}" disabled="{{busy}}" bindtap="enroll">录入并绑定</button><button bindtap="closeEnroll">取消</button></view></view>
<view class="card" wx:if="{{current}}"><view>{{current.id}} · {{current.cageLocation}}</view><textarea placeholder="术后备注（所属学生编辑）" value="{{note}}" data-field="note" bindinput="field"/><button disabled="{{busy}}" bindtap="notes">保存备注</button><picker range="{{numbers}}" bindchange="pickTransfer"><view>目标位置请在上方网格点击选择：{{cageNumber}}</view></picker><button disabled="{{busy}}" bindtap="transfer">转移并通知</button><button disabled="{{busy}}" bindtap="exit">退出并通知</button><input placeholder="手术位置、侧别或坐标" value="{{location}}" data-field="location" bindinput="field"/><button disabled="{{busy}}" bindtap="upload">拍照 / 上传手术照片</button><image wx:for="{{previews}}" wx:key="*this" src="{{item}}" data-url="{{item}}" bindtap="preview" class="photo" mode="aspectFill"/><button disabled="{{busy || !location || !photos.length}}" bindtap="surgery">保存手术位置和照片</button></view><view class="mask" wx:if="{{openCage}}" bindtap="closeCage"><view class="card sheet" catchtap="noop"><view class="title">{{openCage}} · 笼内小鼠</view><button bindtap="showEnroll">新增小鼠</button><picker range="{{types}}" range-key="l" value="{{typeIndex}}" data-field="typeIndex" bindchange="field"><view>操作：{{types[typeIndex].l}}</view></picker><picker range="{{staff}}" range-key="name" value="{{staffIndex}}" data-field="staffIndex" bindchange="field"><view>负责人：{{staff[staffIndex].name || '请选择'}}</view></picker><input placeholder="协助人（可选）" value="{{assistantNames}}" data-field="assistantNames" bindinput="field"/><button disabled="{{busy || !selectedCount}}" loading="{{busy}}" bindtap="dispatch">处理 / 派发所选小鼠</button><view wx:for="{{cageMice}}" wx:key="id" class="mouse-row"><checkbox checked="{{item.checked}}" data-id="{{item.id}}" catchtap="choose"/><text>小鼠名：{{item.id}} · ID：{{item.qrCode || '未绑定'}} · {{item.claimantName}} · {{item.strain}}</text></view><view wx:if="{{!cageMice.length}}">当前笼位暂无小鼠</view><view class="error">{{error}}</view><button bindtap="closeCage">关闭</button></view></view></view>
