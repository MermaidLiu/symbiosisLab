<view class="page"><view class="error" wx:if="{{error}}">{{error}}</view>
<view class="animal-heading"><view><view class="animal-title">动物管理</view><view class="animal-sub">{{racks.length}} 个笼架 · {{list.length}} 只小鼠</view></view><button class="add-animal" bindtap="showEnroll"><text class="ali-icon ali-icon-sm ali-icon-plus"></text>录入小鼠</button></view><view class="view-switch"><view class="mode {{viewMode==='cages'?'mode-active':''}}" bindtap="goCages"><text class="ali-icon ali-icon-sm ali-icon-appstore"></text>笼位模式</view><view class="mode {{viewMode==='list'?'mode-active':''}}" bindtap="goList"><text class="ali-icon ali-icon-sm ali-icon-list"></text>列表模式</view></view><view class="search-box"><view class="ali-icon ali-icon-sm ali-icon-search"></view><input placeholder="搜索小鼠 ID 或小鼠名" placeholder-class="search-placeholder" value="{{query}}" bindinput="search"/></view><view class="selection-hint" wx:if="{{!selectedCount}}"><text class="ali-icon ali-icon-sm ali-icon-info-circle"></text>勾选小鼠，可批量派发任务</view><view class="card dispatch-card" id="dispatch" wx:if="{{selectedCount}}"><view class="dispatch-header"><view class="section-title">派发任务</view><text class="selection-count">已选 {{selectedCount}} 只</text></view><picker range="{{types}}" range-key="l" value="{{typeIndex}}" data-field="typeIndex" bindchange="field"><view class="picker-field"><text class="field-label">操作类型</text><text>{{types[typeIndex].l}}</text><text class="ali-icon ali-icon-sm ali-icon-down"></text></view></picker><picker range="{{staff}}" range-key="name" value="{{staffIndex}}" data-field="staffIndex" bindchange="field"><view class="picker-field"><text class="field-label">主负责人</text><text>{{staff[staffIndex].name || '请选择'}}</text><text class="ali-icon ali-icon-sm ali-icon-down"></text></view></picker><input placeholder="协助人（可选）" value="{{assistantNames}}" data-field="assistantNames" bindinput="field"/><button class="primary-action" loading="{{busy}}" disabled="{{busy || !selectedCount}}" bindtap="dispatch">确认派发</button></view>
<view class="rack-tabs" wx:if="{{viewMode==='cages'}}"><button wx:for="{{racks}}" wx:key="name" size="mini" data-index="{{index}}" bindtap="pickRack" class="{{rackIndex===index?'active':''}}">{{item.name}}</button></view><block wx:if="{{viewMode==='cages'}}"><view wx:for="{{racks}}" wx:for-item="rack" wx:key="name" hidden="{{index!==rackIndex}}"><view class="rack-title">{{rack.name}} · 点击笼位查看小鼠</view><view class="vertical-row" wx:for="{{rack.rows}}" wx:for-item="row" wx:key="row"><view class="row-title">第 {{row.row}} 行</view><view class="vertical-cages"><view class="cage-card {{cell.tone}} {{cell.dimmed?'dimmed':''}}" wx:for="{{row.cells}}" wx:for-item="cell" wx:key="number" data-number="{{cell.number}}" bindtap="pick"><view class="cage-heading"><text>{{cell.number}}</text><text class="muted">{{cell.mice.length}} 只</text></view><view wx:if="{{!cell.mice.length}}" class="cage-empty">空闲笼位</view><view class="cage-mouse" wx:for="{{cell.mice}}" wx:for-item="mouse" wx:key="id"><checkbox checked="{{mouse.checked}}" data-id="{{mouse.id}}" catchtap="choose"/><text>{{mouse.displayName || mouse.id}}</text></view></view></view></view></view></block><view wx:else><view class="card" wx:for="{{list}}" wx:key="id"><view class="title">{{item.displayName || item.id}}</view><view>小鼠 ID：{{item.qrCode || '未绑定'}}</view><view>所属人：{{item.claimantName || '未分配'}}</view><view>笼位：{{item.cageLocation || '未分配'}} · 品系：{{item.strain}}</view><view>进入日期：{{item.cageEntryAt || '未记录'}}</view><view>备注：{{item.cageLabelNote || '—'}}</view><view><checkbox checked="{{item.checked}}" data-id="{{item.id}}" catchtap="choose"/>选择派发<button size="mini" data-id="{{item.id}}" bindtap="open">查看 / 操作</button></view></view></view><view class="card" wx:if="{{legacy.length}}"><view>其他及历史笼位</view><view wx:for="{{legacy}}" wx:key="id"><checkbox checked="{{item.checked}}" data-id="{{item.id}}" bindtap="choose"/><text data-id="{{item.id}}" bindtap="open">{{item.id}} · {{item.cageLocation}}</text></view></view>
<view class="mask enroll-mask" wx:if="{{enrollOpen}}" bindtap="closeEnroll"><view class="card sheet" catchtap="noop"><view>录入小鼠</view><picker range="{{numbers}}" bindchange="pickTransfer"><view>笼位：{{cageNumber}} · 点击选择</view></picker><button bindtap="scan">{{qrScanned ? '重新扫描二维码' : '扫描二维码'}}</button><input placeholder="二维码内容" value="{{qrCode}}" data-field="qrCode" bindinput="field"/><input placeholder="小鼠名，例如 TJ001" value="{{id}}" data-field="id" bindinput="field"/><picker mode="date" value="{{entryDate}}" data-field="entryDate" bindchange="field"><view>进入日期：{{entryDate}}</view></picker><picker range="{{owners}}" range-key="name" value="{{ownerIndex}}" disabled="{{!manager}}" data-field="ownerIndex" bindchange="field"><view>所属人：{{owners[ownerIndex].name}}</view></picker><picker range="{{strainOptions}}" bindchange="pickStrain"><view>选择品系：转基因 / C57</view></picker><input placeholder="品系（可自行输入）" value="{{strain}}" data-field="strain" bindinput="field"/><picker range="{{entryTypes}}" value="{{entryIndex}}" data-field="entryIndex" bindchange="field"><view>进入类型：{{entryTypes[entryIndex]}}</view></picker><input wx:if="{{entryIndex==4}}" placeholder="请填写其他类型" value="{{entryTypeOther}}" data-field="entryTypeOther" bindinput="field"/><picker range="{{housingTypes}}" range-key="label" value="{{housingIndex}}" data-field="housingIndex" bindchange="field"><view>同笼饲养情况：{{housingTypes[housingIndex].label}}</view></picker><input type="digit" placeholder="周龄（如6或8）" value="{{ageWeeks}}" data-field="ageWeeks" bindinput="field"/><input placeholder="备注" value="{{entryNote}}" data-field="entryNote" bindinput="field"/><view class="enroll-actions"><button class="primary-action" loading="{{busy}}" disabled="{{busy}}" bindtap="enroll">录入并绑定</button><button bindtap="closeEnroll">取消</button></view></view></view>
<view class="card" id="animal-detail" wx:if="{{current}}"><view>{{current.id}} · {{current.cageLocation}}</view><textarea placeholder="术后备注（所属学生编辑）" value="{{note}}" data-field="note" bindinput="field"/><button class="primary-action" disabled="{{busy}}" bindtap="notes">保存备注</button><picker range="{{numbers}}" bindchange="pickTransfer"><view>目标笼位：{{cageNumber}}</view></picker><button disabled="{{busy}}" bindtap="transfer">转移并通知</button><button class="danger-action" disabled="{{busy}}" bindtap="exit">退出并通知</button><input placeholder="手术位置、侧别或坐标" value="{{location}}" data-field="location" bindinput="field"/><button disabled="{{busy}}" bindtap="upload">拍照 / 上传手术照片</button><image wx:for="{{previews}}" wx:key="*this" src="{{item}}" data-url="{{item}}" bindtap="preview" class="photo" mode="aspectFill"/><button class="primary-action" disabled="{{busy || !location || !photos.length}}" bindtap="surgery">保存手术位置和照片</button></view><view class="mask" wx:if="{{openCage}}" bindtap="closeCage"><view class="card sheet" catchtap="noop"><view class="title">{{openCage}} · 笼内小鼠</view><button bindtap="showEnroll">新增小鼠</button><picker range="{{types}}" range-key="l" value="{{typeIndex}}" data-field="typeIndex" bindchange="field"><view>操作：{{types[typeIndex].l}}</view></picker><picker range="{{staff}}" range-key="name" value="{{staffIndex}}" data-field="staffIndex" bindchange="field"><view>负责人：{{staff[staffIndex].name || '请选择'}}</view></picker><input placeholder="协助人（可选）" value="{{assistantNames}}" data-field="assistantNames" bindinput="field"/><button class="primary-action" disabled="{{busy || !selectedCount}}" loading="{{busy}}" bindtap="dispatch">处理 / 派发所选小鼠</button><view wx:for="{{cageMice}}" wx:key="id" class="mouse-row"><checkbox checked="{{item.checked}}" data-id="{{item.id}}" catchtap="choose"/><view class="mouse-info"><view data-id="{{item.id}}" data-field="displayName" bindlongpress="editCell">小鼠名：{{item.displayName || item.id}}</view><view data-id="{{item.id}}" data-field="qrCode" bindlongpress="editCell">小鼠 ID：{{item.qrCode || '未绑定'}}</view><view data-id="{{item.id}}" data-field="ownerUserId" bindlongpress="editCell">所属人：{{item.claimantName || '未分配'}}</view><view data-id="{{item.id}}" data-field="strain" bindlongpress="editCell">品系：{{item.strain}}</view><view data-id="{{item.id}}" data-field="cageEntryAt" bindlongpress="editCell">进入日期：{{item.cageEntryAt || '未记录'}}</view><view data-id="{{item.id}}" data-field="cageLabelNote" bindlongpress="editCell">备注：{{item.cageLabelNote || '—'}}</view><button size="mini" data-id="{{item.id}}" bindtap="open">照片 / 转移 / 退出</button></view></view><view wx:if="{{!cageMice.length}}">当前笼位暂无小鼠</view><view class="error">{{error}}</view><button bindtap="closeCage">关闭</button></view></view><view class="mask enroll-mask" wx:if="{{editOwnerId}}" bindtap="closeOwner"><view class="card sheet" catchtap="noop"><view class="title">修改所属人</view><picker range="{{owners}}" range-key="name" value="{{editOwnerIndex}}" data-field="editOwnerIndex" bindchange="field"><view>{{owners[editOwnerIndex].name || '请选择'}}</view></picker><button class="primary-action" disabled="{{busy}}" bindtap="saveOwner">保存</button><button bindtap="closeOwner">取消</button></view></view></view>
