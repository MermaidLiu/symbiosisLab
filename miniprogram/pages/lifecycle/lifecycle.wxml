<view class="wrap">
  <view class="card guest-card" wx:if="{{guestMode}}">
    <view class="guest-title">实验追溯 · 扫码录入</view>
    <view class="guest-desc muted">学生扫鼠笼二维码分配唯一 ID；技术员扫码后上传拍照记录。请先浏览，登录后再操作。</view>
    <button class="btn primary block" bindtap="goLogin">登录后使用</button>
  </view>

  <block wx:else>
  <view class="hero card">
    <view class="title">一鼠一 ID · 一鼠一闭环</view>
    <view class="sub" wx:if="{{isStudent}}">扫描鼠笼二维码 → 分配唯一 ID → 回网页派发技术员</view>
    <view class="sub" wx:else>扫笼码核验派发 ID → 选择操作并拍照 → 提交给学生</view>
  </view>

  <view class="card" wx:if="{{isTech && pendingTasks.length}}">
    <view class="section">待处理任务</view>
    <view
      class="op"
      wx:for="{{pendingTasks}}"
      wx:key="id"
      data-id="{{item.id}}"
      data-animalid="{{item.animalId}}"
      bindtap="pickPending"
    >{{item.animalId}} · {{item.title}} · {{item.studentName}}</view>
  </view>

  <view class="card tip-card" wx:if="{{isTech && expectedHint}}">
    <view class="ok">{{expectedHint}}</view>
  </view>

  <view class="card">
    <view class="label">{{isTech ? '扫笼码核验 / 手动输入笼号' : '笼号（可手动输入测试）'}}</view>
    <input
      class="input"
      placeholder="例如 ML0001，或扫笼码"
      value="{{scanId}}"
      bindinput="onScanId"
      confirm-type="done"
      bindconfirm="onConfirmInput"
    />
    <view class="hint muted" wx:if="{{isStudent}}">二维码未到位前，直接输入笼号点「确认录入」即可分配 Animal ID。</view>
    <view class="hint muted" wx:else>须与网页通知中的派发 Animal ID 为同一只鼠，否则无法继续。</view>
    <view class="row">
      <button class="btn ghost" bindtap="onScanEnroll" wx:if="{{isStudent}}">扫笼码</button>
      <button class="btn ghost" bindtap="onScanLookup" wx:else>扫笼码核验</button>
      <button class="btn primary" loading="{{busy}}" bindtap="onEnroll" wx:if="{{isStudent}}">确认录入</button>
      <button class="btn primary" loading="{{busy}}" bindtap="onLookup" wx:else>确认核验</button>
    </view>
    <view wx:if="{{error}}" class="err">{{error}}</view>
    <view wx:if="{{tip}}" class="ok">{{tip}}</view>
  </view>

  <block wx:if="{{animal}}">
    <view class="card">
      <view class="aid">{{animal.id}}</view>
      <view class="meta">{{animal.strain}} · {{animal.cageLocation}}</view>
      <view class="pill">{{statusLabel}}{{animal.animalLock ? ' · 实验锁定中' : ''}}{{animal.lastOpBackfill ? ' · 补录' : ''}}</view>
      <view class="meta">认领：{{animal.claimantName || '—'}} · 技术员：{{animal.technicianName || '—'}}</view>
    </view>

    <view class="card death" wx:if="{{animal.deathAt}}">
      <view class="section">已登记死亡并终止</view>
      <view class="meta">时间：{{animal.deathAtText}} · {{animal.deathMethodLabel}}</view>
      <view class="meta">原因：{{animal.deathReason}}</view>
    </view>

    <view class="card death" wx:elif="{{canReportDeath}}">
      <view class="section">若小鼠已死亡</view>
      <view class="meta muted">填写时间与原因后终止实验，并通知对方「我已知晓」</view>
      <picker mode="date" value="{{deathDate}}" bindchange="onDeathDate">
        <view class="input">死亡日期：{{deathDate}}</view>
      </picker>
      <picker mode="time" value="{{deathTime}}" bindchange="onDeathTime">
        <view class="input">死亡时间：{{deathTime}}</view>
      </picker>
      <picker range="{{deathMethods}}" range-key="l" value="{{deathMethodIndex}}" bindchange="onDeathMethod">
        <view class="input">方式：{{deathMethods[deathMethodIndex].l}}</view>
      </picker>
      <input class="input" placeholder="死亡原因（必填）" value="{{deathReason}}" bindinput="onDeathReason" />
      <button class="btn ghost block" loading="{{busy}}" bindtap="reportDeath">登记死亡并终止</button>
    </view>

    <!-- 学生：待填 NAS -->
    <view class="card" wx:if="{{isStudent && pendingOp && !animal.deathAt}}">
      <view class="section">待闭环{{pendingOp.backfill ? ' · 补录' : ''}} · {{pendingOp.title}}</view>
      <view class="meta muted">技术员已提交拍照记录，请填写本地 NAS 文件夹路径</view>
      <input class="input" placeholder="\\\\NAS\\lab\\project\\..." value="{{nasPath}}" bindinput="onNasPath" />
      <button class="btn primary block" loading="{{busy}}" bindtap="studentClose">完成闭环</button>
    </view>

    <!-- 技术员：无进行中实验时可创建 -->
    <view class="card" wx:if="{{isTech && animal.registrationStatus === 'awaiting_experiment' && !animal.animalLock && !openOp && !animal.deathAt}}">
      <view class="section">开始本次实验</view>
      <picker range="{{kinds}}" range-key="l" bindchange="onKindChange">
        <view class="input">类型：{{expTitle}}</view>
      </picker>
      <input class="input" placeholder="实验标题" value="{{expTitle}}" bindinput="onExpTitle" />
      <button class="btn primary block" loading="{{busy}}" bindtap="createOp">开始处理</button>
    </view>

    <!-- 技术员：上传照片并完成 -->
    <view class="card" wx:if="{{isTech && openOp && !animal.deathAt}}">
      <view class="section">处理中 · {{openOp.title}}</view>
      <view class="meta muted">请上传结果照片（可多张），再提交给学生</view>
      <input class="input" placeholder="结果说明（可选）" value="{{resultNote}}" bindinput="onResultNote" />
      <button class="btn ghost block" loading="{{busy}}" bindtap="choosePhotos">
        📷 拍照 / 从相册上传结果图（已 {{photoUrls.length}} 张）
      </button>
      <view class="photos" wx:if="{{photoUrls.length}}">
        <image
          wx:for="{{photoUrls}}"
          wx:key="*this"
          src="{{item}}"
          mode="aspectFill"
          class="thumb"
          data-url="{{item}}"
          bindtap="previewPhoto"
          bindlongpress="removePhoto"
        />
      </view>
      <view class="hint muted" wx:if="{{photoUrls.length}}">轻触预览，长按可删除</view>
      <button
        class="btn primary block"
        loading="{{busy}}"
        disabled="{{!photoUrls.length}}"
        bindtap="techSubmit"
      >完成数据采集 · 提交学生</button>
    </view>

    <view class="card" wx:if="{{operations.length}}">
      <view class="section">实验记录</view>
      <block wx:for="{{operations}}" wx:key="id">
        <view class="op">{{item.title}} · {{item.statusText}} · {{item.technicianName}}</view>
        <view wx:if="{{item.nasDataPath}}" class="meta">NAS: {{item.nasDataPath}}</view>
      </block>
    </view>

    <view class="card" wx:if="{{traces.length}}">
      <view class="section">操作日志</view>
      <block wx:for="{{traces}}" wx:key="id">
        <view class="trace">{{item.timestamp}} · {{item.userName}} · {{item.details}}</view>
      </block>
    </view>
  </block>
  </block>
</view>
