<view class="wrap">
  <view class="card guest-card" wx:if="{{guestMode}}">
    <view class="guest-title">实验追溯 · 扫码录入</view>
    <view class="guest-desc muted">学生扫鼠笼二维码分配唯一 ID；技术员扫码后上传拍照记录。请先浏览，登录后再操作。</view>
    <button class="btn primary block" bindtap="goLogin">登录后使用</button>
  </view>

  <block wx:else>
  <view class="hero card">
    <view class="title">一鼠一 ID · 一鼠一闭环</view>
    <view class="sub" wx:if="{{isStudent}}">扫描鼠笼二维码 → 分配唯一 ID → 回网页派发技术员</view>
    <view class="sub" wx:else>扫笼码核验派发 ID → 选择操作并拍照 → 提交给学生</view>
  </view>

  <view class="card" wx:if="{{isTech && activeAnimalTasks.length}}"><view class="section">当前操作任务</view><input class="input" placeholder="协助完成人（可选）" value="{{assistantNames}}" bindinput="onAssistantNames"/><view wx:for="{{activeAnimalTasks}}" wx:key="id"><view>{{item.taskTitle}} · 小鼠 {{item.mouseLabels}}</view><view>{{item.note}}</view><button data-id="{{item.id}}" bindtap="completeSimpleTask">操作已完成 · 通知下一步</button></view></view>
  <view class="card" wx:if="{{isTech && waitingTasks.length}}"><view class="section">待接手的后续步骤</view><view wx:for="{{waitingTasks}}" wx:key="id"><view>{{item.taskTitle}} · 小鼠 {{item.mouseLabels}}</view><view class="meta">派发人：{{item.createdByName}} · 备注：{{item.note}}</view><view class="hint muted">等待 {{item.waitingForName}} 完成前一步，届时自动通知。</view></view></view>
  <view class="card" wx:if="{{isTech && pendingTasks.length}}">
    <view class="section">待处理任务</view>
    <view
      class="op"
      wx:for="{{pendingTasks}}"
      wx:key="id"
      data-id="{{item.id}}"
      data-animalid="{{item.animalId}}"
      bindtap="pickPending"
    >{{item.animalId}} · {{item.title}} · {{item.studentName}}</view>
  </view>

  <view class="card tip-card" wx:if="{{isTech && expectedHint}}">
    <view class="ok">{{expectedHint}}</view>
  </view>

  <view class="card">
    <view class="label">{{isTech ? '扫笼码核验 / 手动输入笼号' : '小鼠二维码下方编号'}}</view>
    <input
      class="input"
      placeholder="扫描小鼠二维码或输入二维码下方编号"
      value="{{scanId}}"
      bindinput="onScanId"
      confirm-type="done"
      bindconfirm="onConfirmInput"
    />
<view><input class="input" placeholder="小鼠编号，例如 TJ001" value="{{customId}}" bindinput="onCustomId" /><input class="input" placeholder="笼位，例如 1A1" value="{{cageNumber}}" bindinput="onCageNumber" /><input class="input" placeholder="品系" value="{{enrollStrain}}" bindinput="onEnrollStrain" /></view>
    <view class="hint muted" wx:if="{{isStudent}}">扫描小鼠二维码，再填写习惯使用的小鼠编号与笼位。</view>
    <view class="hint muted" wx:else>须与网页通知中的派发 Animal ID 为同一只鼠，否则无法继续。</view>
    <view class="row">
      <button class="btn ghost" bindtap="onScanEnroll" wx:if="{{isStudent}}">扫笼码</button>
      <button class="btn ghost" bindtap="onScanLookup" wx:else>扫笼码核验</button>
      <button class="btn primary" loading="{{busy}}" bindtap="onEnroll" wx:if="{{isStudent}}">确认录入</button>
      <button class="btn primary" loading="{{busy}}" bindtap="onLookup" wx:else>确认核验</button>
    </view>
    <button wx:if="{{isTech}}" class="btn ghost" bindtap="onEnroll">登记新小鼠（填上方编号、笼位和品系）</button>
    <view wx:if="{{error}}" class="err">{{error}}</view>
    <view wx:if="{{tip}}" class="ok">{{tip}}</view>
  </view>

  <block wx:if="{{animal}}">
    <view class="card">
      <view class="aid">{{animal.id}}</view>
      <view class="meta">{{animal.strain}} · {{animal.cageLocation}}</view>
      <view class="pill">{{statusLabel}}{{animal.animalLock ? ' · 实验锁定中' : ''}}{{animal.lastOpBackfill ? ' · 补录' : ''}}</view>
      <view class="meta">认领：{{animal.claimantName || '—'}} · 技术员：{{animal.technicianName || '—'}}</view>
    </view>

    <view class="card death" wx:if="{{animal.deathAt}}">
      <view class="section">已登记死亡并终止</view>
      <view class="meta">时间：{{animal.deathAtText}} · {{animal.deathMethodLabel}}</view>
      <view class="meta">原因：{{animal.deathReason}}</view>
    </view>

    <!-- 学生：待填 NAS -->
    <view class="card" wx:if="{{isStudent && pendingOp && !animal.deathAt}}">
      <view class="section">待闭环{{pendingOp.backfill ? ' · 补录' : ''}} · {{pendingOp.title}}</view>
      <view class="meta muted">技术员已提交结果，请填写本地 NAS 文件夹路径</view>
      <input class="input" placeholder="\\\\NAS\\lab\\project\\..." value="{{nasPath}}" bindinput="onNasPath" />
      <radio-group wx:if="{{pendingOp.dataTransferred === true}}" bindchange="onFileSeen"><view>是否在文件夹中看到此文件</view><label><radio value="true" />是</label><label><radio value="false" />否（通知技术员核查）</label></radio-group>
      <button class="btn primary block" loading="{{busy}}" bindtap="studentClose">{{studentFileSeen === false ? "反馈未看到文件" : "完成闭环"}}</button>
    </view>

    <!-- 技术员：无进行中实验时可创建 -->
    <view class="card" wx:if="{{isTech && animal.registrationStatus === 'awaiting_experiment' && !animal.animalLock && !openOp && !animal.deathAt}}">
      <view class="section">开始本次实验</view>
      <picker range="{{kinds}}" range-key="l" bindchange="onKindChange">
        <view class="input">类型：{{expTitle}}</view>
      </picker>
      <input class="input" placeholder="实验标题" value="{{expTitle}}" bindinput="onExpTitle" />
      <button class="btn primary block" loading="{{busy}}" bindtap="createOp">开始处理</button>
    </view>

    <!-- 技术员：上传照片并完成 -->
    <view class="card" wx:if="{{isTech && openOp && openOp.technicianUserId === currentUserId && !animal.deathAt}}">
      <view class="section">处理中 · {{openOp.title}}</view>
      <radio-group bindchange="onTransfer"><view>是否传输</view><label><radio value="true" checked="{{dataTransferred === true}}" />是（上传照片）</label><label><radio value="false" checked="{{dataTransferred === false}}" />否（不上传照片）</label></radio-group>
      <input class="input" placeholder="手术位置（手术任务必填）" value="{{surgeryLocation}}" bindinput="onSurgeryLocation" />
      <input class="input" placeholder="协助完成人（手动录入，可选）" value="{{assistantNames}}" bindinput="onAssistantNames" />
      <input class="input" placeholder="结果说明（可选）" value="{{resultNote}}" bindinput="onResultNote" />
      <button class="btn ghost block" loading="{{uploading || busy}}" disabled="{{dataTransferred !== true && !surgeryLocation}}" bindtap="choosePhotos">
        📷 拍照 / 从相册上传结果图（已 {{photoUrls.length}} 张）
      </button>
      <view class="hint muted" wx:if="{{uploading}}">上传中 {{uploadProgress}}%…</view>
      <view class="photos" wx:if="{{photoPreviews.length}}">
        <image
          wx:for="{{photoPreviews}}"
          wx:for-index="idx"
          wx:key="*this"
          src="{{item}}"
          mode="aspectFill"
          class="thumb"
          data-index="{{idx}}"
          bindtap="previewPhoto"
          bindlongpress="removePhoto"
        />
      </view>
      <view class="hint muted" wx:if="{{photoUrls.length}}">轻触预览，长按可删除</view>
      <view class="hint muted" wx:elif="{{!photoUrls.length}}">选择是时须上传至少 1 张传输照片</view>
      <button
        class="btn primary block"
        loading="{{busy}}"
        disabled="{{dataTransferred === null || (dataTransferred && !photoUrls.length)}}"
        bindtap="techSubmit"
      >完成数据采集 · 提交学生</button>
    </view>

    <view class="card" wx:if="{{operations.length}}">
      <view class="section">实验记录</view>
      <block wx:for="{{operations}}" wx:key="id">
        <view class="op">{{item.title}} · {{item.statusText}} · {{item.technicianName}}</view>
        <view wx:if="{{item.assistantNames}}" class="meta">协助完成人：{{item.assistantNames}}</view>
        <view class="meta">传输：{{item.dataTransferred === undefined ? '未记录' : (item.dataTransferred ? '是' : '否')}} · 学生看到文件：{{item.studentFileSeen === undefined ? '未反馈' : (item.studentFileSeen ? '是' : '否')}}</view>
        <view class="photos"><image wx:for="{{item.photoPreviews}}" wx:for-item="photo" wx:key="*this" src="{{photo}}" mode="aspectFill" class="thumb" data-operation="{{item.id}}" data-url="{{photo}}" bindtap="previewRecordPhoto" /></view>
        <view wx:if="{{item.nasDataPath}}" class="meta">NAS: {{item.nasDataPath}}</view>
      </block>
    </view>

    <view class="card" wx:if="{{traces.length}}">
      <view class="section">操作日志</view>
      <block wx:for="{{traces}}" wx:key="id">
        <view class="trace">{{item.timestamp}} · {{item.userName}} · {{item.details}}</view>
      </block>
    </view>
  </block>
  </block>
</view>
