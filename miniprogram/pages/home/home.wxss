.page {
  padding-bottom: 48rpx;
  min-height: 100vh;
}

.hero {
  position: relative;
  margin: 24rpx;
  padding: 40rpx 32rpx 36rpx;
  border-radius: 36rpx;
  overflow: hidden;
  color: #fff;
  background: linear-gradient(145deg, #b794f6 0%, #7b4db8 48%, #5b3a9e 100%);
  box-shadow: 0 18rpx 40rpx rgba(123, 77, 184, 0.28);
}

.hero-glow {
  position: absolute;
  right: -40rpx;
  top: -60rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 246, 194, 0.55), transparent 70%);
}

.hello {
  position: relative;
  font-size: 40rpx;
  font-weight: 700;
}

.roles {
  position: relative;
  margin-top: 10rpx;
  font-size: 24rpx;
  opacity: 0.88;
}

.hero-chip {
  position: relative;
  display: inline-flex;
  margin-top: 22rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: rgba(255, 255, 255, 0.22);
}

.overview {
  padding-top: 24rpx;
  padding-bottom: 12rpx;
}

.metrics {
  display: flex;
  margin-top: 18rpx;
}

.metric {
  flex: 1;
  text-align: center;
  padding: 12rpx 0 8rpx;
}

.metric-num {
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.1;
}

.metric-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #7a7190;
}

.c-grape { color: #5b3a9e; }
.c-mint { color: #1b7a5a; }
.c-sky { color: #1a6b8a; }
.c-rose { color: #b83b5e; }

.grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx;
}

.tile {
  width: 33.33%;
  padding: 16rpx 8rpx 20rpx;
  box-sizing: border-box;
  text-align: center;
}

.icon {
  width: 88rpx;
  height: 88rpx;
  margin: 0 auto 12rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 20rpx rgba(90, 70, 120, 0.12);
}

.jelly-sky {
  background: linear-gradient(145deg, #e8f7ff, #a8ddff);
}
.jelly-lemon {
  background: linear-gradient(145deg, #fff9d6, #ffe08a);
}
.jelly-mint {
  background: linear-gradient(145deg, #e6fff3, #8eebc0);
}
.jelly-rose {
  background: linear-gradient(145deg, #ffe8ef, #ffb0c4);
}
.jelly-peach {
  background: linear-gradient(145deg, #fff0e4, #ffc49a);
}
.jelly-grape {
  background: linear-gradient(145deg, #f1e9ff, #c9b0f5);
}

.tile-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #2a2340;
}

.tile-sub {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #8b829c;
}

.cal-card {
  padding-bottom: 20rpx;
}

.cal-card.collapsed {
  padding-bottom: 24rpx;
}

.cal-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.cal-top-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.cal-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.cal-entry {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #ede0ff;
  font-size: 22rpx;
  color: #5b3a9e;
  font-weight: 600;
}

.chevron {
  width: 44rpx;
  height: 44rpx;
  border-radius: 14rpx;
  background: #f3eaff;
  color: #5b3a9e;
  text-align: center;
  line-height: 40rpx;
  font-size: 32rpx;
  font-weight: 700;
  transform: rotate(90deg);
  transition: transform 0.2s ease;
}

.chevron.up {
  transform: rotate(-90deg);
}

.mini-cal {
  margin-top: 16rpx;
  padding-top: 8rpx;
  border-top: 2rpx solid #f3eaff;
}

.mini-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.mini-month {
  font-size: 28rpx;
  font-weight: 700;
  color: #5b3a9e;
}

.mini-nav {
  width: 52rpx;
  height: 52rpx;
  border-radius: 16rpx;
  background: #f3eaff;
  color: #5b3a9e;
  text-align: center;
  line-height: 48rpx;
  font-size: 34rpx;
}

.mini-weeks {
  display: flex;
  flex-direction: row;
  width: 100%;
}

.mw {
  flex: 1;
  text-align: center;
  font-size: 20rpx;
  color: #9a90b0;
  padding: 6rpx 0 4rpx;
  box-sizing: border-box;
}

.mini-row {
  display: flex;
  flex-direction: row;
  width: 100%;
  height: 64rpx;
  align-items: center;
}

.mc {
  position: relative;
  flex: 1;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.mc.empty {
  pointer-events: none;
}

.mc-inner {
  width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  border-radius: 16rpx;
  font-size: 24rpx;
  color: #2a2340;
}

.mc.today .mc-inner {
  background: #d0eeff;
  color: #1a6b8a;
  font-weight: 700;
}

.mc.marked .mc-inner {
  font-weight: 700;
}

.m-dot {
  position: absolute;
  left: 50%;
  bottom: 4rpx;
  width: 8rpx;
  height: 8rpx;
  margin-left: -4rpx;
  border-radius: 50%;
  background: #ff8fb3;
  pointer-events: none;
}
