@import "./styles/icons.wxss";

/* Daigroup Lab MP — Fluent jelly palette */
page {
  --jelly-mint: #c8f7e0;
  --jelly-peach: #ffe0c8;
  --jelly-lavender: #ede0ff;
  --jelly-sky: #d0eeff;
  --jelly-lemon: #fff6c2;
  --jelly-rose: #ffd6e0;
  --jelly-grape: #e2d4ff;
  --ink: #2a2340;
  --muted: #7a7190;
  --brand: #7b4db8;
  --brand-deep: #5b3a9e;
  background: #f6f5f8;
  background-attachment: fixed;
  color: var(--ink);
  font-size: 28rpx;
  box-sizing: border-box;
}

.card {
  background: rgba(255, 255, 255, 0.82);
  border-radius: 28rpx;
  padding: 28rpx;
  margin: 20rpx 24rpx;
  box-shadow: none;
  border: 2rpx solid rgba(255, 255, 255, 0.9);
}

.btn-primary {
  background: #f6f5f8;
  color: #fff;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: none;
  border: none;
}

.btn-primary::after {
  border: none;
}

.btn-ghost {
  background: var(--jelly-lavender);
  color: var(--brand-deep);
  border-radius: 999rpx;
  border: none;
}

.btn-ghost::after {
  border: none;
}

.muted {
  color: var(--muted);
}

.tip {
  display: inline-flex;
  align-items: center;
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.empty {
  text-align: center;
  color: var(--muted);
  padding: 100rpx 40rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 8rpx 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
}

.section-sub {
  font-size: 22rpx;
  color: var(--muted);
}

.guest-card .guest-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--brand-deep);
}

.guest-card .guest-desc {
  margin: 12rpx 0 28rpx;
  font-size: 26rpx;
  line-height: 1.55;
}

.guest-card .btn-primary,
.guest-card .btn.primary {
  margin-top: 8rpx;
}

/* Flat visual system */
page{background:#f6f5f8;color:#302c3d}.card,.hero{background:#fff!important;border:1rpx solid #e6e1eb;box-shadow:none!important}.blob,.hero-glow{display:none}.icon{background:transparent!important;box-shadow:none!important}.btn-primary,.btn.primary{background:#75258c!important;color:#fff!important;border:0}.btn-ghost,.btn.ghost{background:#fff!important;color:#75258c;border:1rpx solid #ddd3e5}

.hero{color:#302c3d!important}.hero-chip{background:#f3edf7;color:#75258c}

.check.on{background:#fff!important;border-color:#75258c!important}
